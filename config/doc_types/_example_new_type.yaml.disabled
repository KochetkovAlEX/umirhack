# ДЕМО бонуса «новый тип без кода».
# Чтобы включить: переименуйте файл в transfer_application.yaml (уберите .disabled)
# и перезапустите сервис. Тип появится в веб-интерфейсе и в Telegram-боте,
# поля извлекаются стандартными обработчиками (text/date/person_name/...).
# Пункты Положения (rules_section) для демонстрации ссылаются на раздел 4,
# т.к. в учебном Положении для этого типа отдельного раздела нет.
key: transfer_application
title: Заявление о переводе
rules_section: "4"
detect:
  title_keywords: ["заявление о переводе", "о переводе"]
  label_keywords: ["текущий вуз", "желаемое направление", "дата заявления"]
complete_message_rules: ["4.1", "4.2"]
fields:
  - key: student_name
    label: ФИО студента
    aliases: ["фио", "студент"]
    type: person_name
    rule: "4.1"
  - key: current_university
    label: Текущий вуз
    aliases: ["откуда переводится", "вуз"]
    type: text
    rule: "4.1"
  - key: target_program
    label: Желаемое направление
    aliases: ["куда переводится", "направление"]
    type: text
    rule: "4.1"
  - key: application_date
    label: Дата заявления
    aliases: ["когда подано"]
    type: date
    rule: "4.1"
  - key: signature_present
    label: Подпись студента
    aliases: ["подпись"]
    type: signature
    anchor: "подпись студента"
    rule: "4.2"
